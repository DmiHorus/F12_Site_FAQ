# Провайдер эмбеддингов: openai или local.
# openai — text-embedding-3-small через API (нужен OPENAI_API_KEY).
# local — модель sentence-transformers с диска; для семейства e5 код сам добавляет префиксы query: и passage:.
EMBEDDING_PROVIDER=openai

# Имя модели эмбеддингов. Для local, например: intfloat/multilingual-e5-small
EMBEDDING_MODEL=text-embedding-3-small

# Как формулируется ответ: extractive (текст из FAQ), local_llm (Ollama), openai.
ANSWER_MODE=openai

# Имя модели генерации. Для openai: gpt-4.1-mini. Для local_llm: имя модели в Ollama.
LLM_MODEL=gpt-4.1-mini

# Минимальное косинусное сходство. Ниже порога ассистент отказывает, не вызывая генерацию.
SCORE_THRESHOLD=0.31

# Сколько фрагментов отдавать в /chat, если в запросе не передан top_k.
TOP_K=3

# Адрес, на котором учебный сценарий запускает uvicorn.
HOST=127.0.0.1
PORT=8000

# Подмешивать ли *.txt из data/ в индекс. Для этой базы должно быть false.
INDEX_TXT_DOCS=false

# Ключ OpenAI. Нужен только если EMBEDDING_PROVIDER=openai или ANSWER_MODE=openai.
# Значение сюда не вписывайте: скопируйте файл в .env и добавьте ключ локально.
OPENAI_API_KEY=
